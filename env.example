# ============================================
# SmartFinancial AI — Environment Variables
# ============================================

# --- API Keys ---
# Twelve Data (primary stock quotes) — https://twelvedata.com/
TWELVE_API_KEY=your_twelve_data_api_key_here

# Finnhub (financial news) — https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Server Configuration ---
PORT=5000
NODE_ENV=development

# --- Analytics Engine ---
# URL where the FastAPI analytics service is running
ANALYTICS_URL=http://localhost:8000
